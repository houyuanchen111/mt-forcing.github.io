# Keep the repository root limited to the published website and Git metadata.
/*
!/.gitattributes
!/.gitignore
!/.nojekyll
!/README.md
!/LICENSE
!/LICENSE.*
!/CNAME
!/.github/
!/index.html
!/styles.css
!/app.js
!/data.js
!/links.js
!/assets/
!/videos/

# OS, editor, and Python cache files
.DS_Store
._*
Thumbs.db
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/
*.swp
*.swo

# Local configuration and credentials
.env
.env.*
!.env.example
